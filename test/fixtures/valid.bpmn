<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:pm="https://github.com/teflux77/bpmn-collab-mcp/schema/process-meta/1.0"
  id="Definitions_Order" targetNamespace="https://github.com/teflux77/bpmn-collab-mcp/bpmn">
  <bpmn:process id="Process_Order" name="Handle order" isExecutable="false">
    <bpmn:extensionElements>
      <pm:meta owner="Sales" level="3" />
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_CheckOrder" name="Check order">
      <bpmn:extensionElements>
        <pm:meta owner="Sales clerk" sla="PT4H" formRef="form-check-order" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_Order">
        <bpmn:targetRef>DataRef_Order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Approved" name="Order approved?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_ShipOrder" name="Ship order">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="End_Shipped" name="Order shipped">
      <bpmn:incoming>Flow_4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_Rejected" name="Order rejected">
      <bpmn:incoming>Flow_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_OrderReceived" targetRef="Task_CheckOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckOrder" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_Yes" name="Yes" sourceRef="Gateway_Approved" targetRef="Task_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_No" name="No" sourceRef="Gateway_Approved" targetRef="End_Rejected" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ShipOrder" targetRef="End_Shipped" />
    <bpmn:dataObjectReference id="DataRef_Order" name="Order" dataObjectRef="DataObject_Order" />
    <bpmn:dataObject id="DataObject_Order" />
    <bpmn:textAnnotation id="Annotation_Carrier">
      <bpmn:text>Carrier chosen by weight</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Carrier" sourceRef="Task_ShipOrder" targetRef="Annotation_Carrier" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Order">
    <bpmndi:BPMNPlane id="BPMNPlane_Order" bpmnElement="Process_Order">
      <bpmndi:BPMNShape id="Start_OrderReceived_di" bpmnElement="Start_OrderReceived">
        <dc:Bounds x="152" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="248" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckOrder_di" bpmnElement="Task_CheckOrder">
        <dc:Bounds x="240" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Approved_di" bpmnElement="Gateway_Approved" isMarkerVisible="true">
        <dc:Bounds x="395" y="195" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="380" y="160" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ShipOrder_di" bpmnElement="Task_ShipOrder">
        <dc:Bounds x="500" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Shipped_di" bpmnElement="End_Shipped">
        <dc:Bounds x="652" y="202" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="635" y="250" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Rejected_di" bpmnElement="End_Rejected">
        <dc:Bounds x="652" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="635" y="360" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DataRef_Order_di" bpmnElement="DataRef_Order">
        <dc:Bounds x="272" y="320" width="36" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="272" y="378" width="36" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_Carrier_di" bpmnElement="Annotation_Carrier">
        <dc:Bounds x="490" y="60" width="120" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="220" />
        <di:waypoint x="240" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="220" />
        <di:waypoint x="395" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Yes_di" bpmnElement="Flow_Yes">
        <di:waypoint x="445" y="220" />
        <di:waypoint x="500" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="460" y="198" width="20" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_No_di" bpmnElement="Flow_No">
        <di:waypoint x="420" y="245" />
        <di:waypoint x="420" y="330" />
        <di:waypoint x="652" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="432" y="270" width="16" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="600" y="220" />
        <di:waypoint x="652" y="220" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DataOut_Order_di" bpmnElement="DataOut_Order">
        <di:waypoint x="290" y="260" />
        <di:waypoint x="290" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_Carrier_di" bpmnElement="Association_Carrier">
        <di:waypoint x="550" y="180" />
        <di:waypoint x="550" y="100" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
