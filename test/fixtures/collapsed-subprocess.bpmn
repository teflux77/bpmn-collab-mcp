<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  id="Definitions_Sub" targetNamespace="https://github.com/teflux77/bpmn-collab-mcp/bpmn">
  <bpmn:process id="Process_Order" name="Handle order" isExecutable="false">
    <bpmn:startEvent id="Start_OrderReceived" name="Order received">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_CheckOrder" name="Check order">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:subProcess id="Sub_ShipOrder" name="Ship order">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
      <bpmn:startEvent id="Start_Ship" name="Order to ship">
        <bpmn:outgoing>Flow_S1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:task id="Task_PickItems" name="Pick items">
        <bpmn:incoming>Flow_S1</bpmn:incoming>
        <bpmn:outgoing>Flow_S2</bpmn:outgoing>
      </bpmn:task>
      <bpmn:task id="Task_PackParcel" name="Pack parcel">
        <bpmn:incoming>Flow_S2</bpmn:incoming>
        <bpmn:outgoing>Flow_S3</bpmn:outgoing>
      </bpmn:task>
      <bpmn:endEvent id="End_Packed" name="Parcel packed">
        <bpmn:incoming>Flow_S3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_Ship" targetRef="Task_PickItems" />
      <bpmn:sequenceFlow id="Flow_S2" sourceRef="Task_PickItems" targetRef="Task_PackParcel" />
      <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_PackParcel" targetRef="End_Packed" />
    </bpmn:subProcess>
    <bpmn:endEvent id="End_Shipped" name="Order shipped">
      <bpmn:incoming>Flow_3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_OrderReceived" targetRef="Task_CheckOrder" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CheckOrder" targetRef="Sub_ShipOrder" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Sub_ShipOrder" targetRef="End_Shipped" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Order">
    <bpmndi:BPMNPlane id="BPMNPlane_Order" bpmnElement="Process_Order">
      <bpmndi:BPMNShape id="Start_OrderReceived_di" bpmnElement="Start_OrderReceived">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="148" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CheckOrder_di" bpmnElement="Task_CheckOrder">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_ShipOrder_di" bpmnElement="Sub_ShipOrder" isExpanded="false">
        <dc:Bounds x="400" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Shipped_di" bpmnElement="End_Shipped">
        <dc:Bounds x="562" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="545" y="148" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="400" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="500" y="120" />
        <di:waypoint x="562" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
  <!-- drill-down plane of the collapsed sub-process: same coordinates range as the main plane on purpose -->
  <bpmndi:BPMNDiagram id="BPMNDiagram_Ship">
    <bpmndi:BPMNPlane id="BPMNPlane_Ship" bpmnElement="Sub_ShipOrder">
      <bpmndi:BPMNShape id="Start_Ship_di" bpmnElement="Start_Ship">
        <dc:Bounds x="152" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="135" y="148" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PickItems_di" bpmnElement="Task_PickItems">
        <dc:Bounds x="240" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PackParcel_di" bpmnElement="Task_PackParcel">
        <dc:Bounds x="400" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_Packed_di" bpmnElement="End_Packed">
        <dc:Bounds x="562" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="545" y="148" width="70" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_S1_di" bpmnElement="Flow_S1">
        <di:waypoint x="188" y="120" />
        <di:waypoint x="240" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S2_di" bpmnElement="Flow_S2">
        <di:waypoint x="340" y="120" />
        <di:waypoint x="400" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_S3_di" bpmnElement="Flow_S3">
        <di:waypoint x="500" y="120" />
        <di:waypoint x="562" y="120" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
