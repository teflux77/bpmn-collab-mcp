# Copy to .env.local (ignored by git) and fill in. Never commit real values.
# Scripts load it themselves: node --env-file-if-exists=.env.local scripts/<script>.mjs

# Gandi personal access token, scoped to teflux.dev / LiveDNS, short expiry
GANDI_PAT=
# Hetzner Cloud API token (read & write), this project only
HCLOUD_TOKEN=

# Not secrets, kept here so scripts and docs never hard-code them
VPS_IP=
# optional: the VPS IPv6 address (npm run firewall prints it), adds an AAAA record
VPS_IPV6=
# your public IP, allowed on SSH and /mcp; update it with `npm run firewall -- --apply`
ADMIN_IP=

DOMAIN=teflux.dev
SUBDOMAIN=bpmn
