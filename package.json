{
  "name": "bpmn-collab-mcp",
  "version": "0.1.0",
  "description": "MCP server + bpmn-js canvas for human/AI collaborative BPMN modeling",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:server": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/moddle','dist/moddle',{recursive:true})\"",
    "build": "npm run build:ui && npm run build:server",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "@modelcontextprotocol/express": "2.0.2",
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "bpmn-js-differ": "3.2.0",
    "bpmn-moddle": "10.3.1",
    "bpmnlint": "12.0.0",
    "express": "5.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "bpmn-js": "18.31.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
